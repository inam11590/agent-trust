# Server-side backend URL used by Next.js route handlers.
AGENTTRUST_API_URL=http://127.0.0.1:8000

# Public fallback for local setups. This value must never contain credentials.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Set true only when the public site is served over HTTPS.
AGENTTRUST_HTTPS=false
