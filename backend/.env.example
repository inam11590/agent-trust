# development, test, staging, or production. Staging/production validation is strict.
APP_ENV=development

# Generate a unique random key (at least 32 bytes); keep the real value in .env.
JWT_SECRET_KEY=
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_ISSUER=agenttrust
JWT_AUDIENCE=agenttrust-api
# 32 random bytes encoded with urlsafe base64 (Fernet key); keep in secret storage.
MFA_ENCRYPTION_KEY=
AUDIT_RETENTION_DAYS=365
SECURITY_EVENT_RETENTION_DAYS=365
NOTIFICATION_DELIVERY_RETENTION_DAYS=30
MFA_CHALLENGE_EXPIRE_MINUTES=5
MFA_MAX_ATTEMPTS=5
MFA_LOCK_MINUTES=15
MFA_RATE_LIMIT_PER_MINUTE=10

# Local PostgreSQL connection. Copy to .env and fill in private credentials.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=agenttrust
# Use a dedicated database role. Never commit real credentials.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_CONNECT_TIMEOUT=5
# Use verify-full with a trusted certificate for a remote production database.
POSTGRES_SSLMODE=prefer
# Optional managed-PostgreSQL connection URL. Keep it secret.
DATABASE_URL=
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=10
DATABASE_POOL_RECYCLE_SECONDS=1800

# Redis is temporary infrastructure for distributed rate limits. PostgreSQL remains authoritative.
REDIS_URL=
REDIS_REQUIRED=false
RATE_LIMIT_BACKEND=memory

# JSON logs, protected metrics, and optional error tracking.
LOG_LEVEL=INFO
METRICS_AUTH_TOKEN=
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_TRACES_SAMPLE_RATE=0

# Developer API limits are enforced per API key. Use Redis before multi-instance deployment.
DEVELOPER_RATE_LIMIT_PER_MINUTE=100

# Signed agent requests: Redis is used for atomic replay protection when REDIS_URL is set.
# Without Redis, local/test installations use a PostgreSQL unique-nonce fallback.
AGENT_SIGNATURE_CLOCK_WINDOW_SECONDS=300
AGENT_SIGNED_BODY_MAX_BYTES=65536
AGENT_MAX_ACTIVE_SIGNING_KEYS=3
AGENT_KEY_EXPIRY_WARNING_DAYS=7
AGENT_SIGNATURE_FAILURE_LIMIT_PER_MINUTE=20

# Random server-side secret used to derive a different signing secret per organization.
WEBHOOK_SIGNING_KEY=
WEBHOOK_TIMEOUT_SECONDS=5
WEBHOOK_SIGNATURE_TOLERANCE_SECONDS=300

# Organization invitations. Links are returned only in local/test mode.
INVITATION_EXPIRE_DAYS=7
INVITATION_BIND_EMAIL=true
WEB_APP_URL=http://127.0.0.1:3000
API_PUBLIC_URL=http://127.0.0.1:8000

# Comma-separated exact browser origins. Never use * with credentials in production.
CORS_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# Per-process authentication protection. Use a shared limiter before multi-instance deployment.
AUTH_LOGIN_RATE_LIMIT_PER_MINUTE=10
AUTH_REGISTER_RATE_LIMIT_PER_MINUTE=20
ACCOUNT_LOCK_ATTEMPTS=5
ACCOUNT_LOCK_MINUTES=15

# Notifications. Development email creates a safe preview result without a network call.
EMAIL_PROVIDER=development
EMAIL_API_KEY=
EMAIL_FROM_ADDRESS=notifications@agenttrust.local
EMAIL_FROM_NAME=AgentTrust

# Firebase Cloud Messaging HTTP v1. Keep these credentials in the worker environment only.
FCM_PROJECT_ID=
FCM_ACCESS_TOKEN=
NOTIFICATION_DELIVERY_TIMEOUT_SECONDS=8
NOTIFICATION_MAX_DELIVERY_ATTEMPTS=3
NOTIFICATION_RETRY_BASE_SECONDS=30
NOTIFICATION_WORKER_BATCH_SIZE=50
NOTIFICATION_WORKER_POLL_SECONDS=10
PERMISSION_EXPIRY_WARNING_MINUTES=60

# Transparent rule-based risk engine thresholds and recent windows.
RISK_LOW_MAX=29
RISK_MEDIUM_MAX=59
RISK_HIGH_MAX=79
RISK_HISTORY_DAYS=30
RISK_VELOCITY_WINDOW_SECONDS=60
RISK_VELOCITY_MEDIUM_COUNT=5
RISK_VELOCITY_HIGH_COUNT=10
RISK_VELOCITY_CRITICAL_COUNT=30
RISK_REJECTION_WINDOW_MINUTES=10
RISK_NEW_AGENT_HOURS=24
RISK_RECENT_PERMISSION_MINUTES=60
# Billing is test-only by default. Never use live provider credentials here.
BILLING_PROVIDER=test
BILLING_SECRET_KEY=
BILLING_WEBHOOK_SECRET=
BILLING_WEBHOOK_TOLERANCE_SECONDS=300
BILLING_GRACE_PERIOD_DAYS=7
BILLING_ADMIN_CAN_MANAGE=true
# Catalog display prices (USD). Provider price IDs below remain server-only mappings.
BILLING_STARTER_MONTHLY_PRICE=29.00
BILLING_BUSINESS_MONTHLY_PRICE=149.00
BILLING_PRICE_STARTER_MONTHLY=
BILLING_PRICE_BUSINESS_MONTHLY=
BILLING_PADDLE_API_URL=https://sandbox-api.paddle.com
