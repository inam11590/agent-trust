    {
      "name": "Authorization Engine",
      "item": [
        {
          "name": "Authorize Action",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-API-Key",
                "value": "{{API_KEY}}"
              },
              {
                "key": "Idempotency-Key",
                "value": "checkout-req-001"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"agent_id\": \"{{AGENT_ID}}\", \"action\": \"purchase\", \"resource\": \"flight\", \"amount\": 300.0, \"currency\": \"USD\"}"
            },
            "url": {
              "raw": "{{BASE_URL}}/api/v1/authorize",
              "host": [
                "{{BASE_URL}}"
              ],
              "path": [
                "api",
                "v1",
                "authorize"
              ]
            }
          }
        },
        {
          "name": "Get Authorization Request Status",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{API_KEY}}"
              }
            ],
            "url": {
              "raw": "{{BASE_URL}}/api/v1/authorization-requests/{{REQUEST_ID}}",
              "host": [
                "{{BASE_URL}}"
              ],
              "path": [
                "api",
                "v1",
                "authorization-requests",
                "{{REQUEST_ID}}"
              ]
            }
          }
        }
      ]
    },
