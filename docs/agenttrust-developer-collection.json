  },
  "variable": [
    {
      "key": "BASE_URL",
      "value": "http://localhost:8000",
      "type": "string"
    },
    {
      "key": "API_KEY",
      "value": "at_test_replace_with_your_sandbox_api_key_here",
      "type": "string"
    },
    {
      "key": "AGENT_ID",
      "value": "agt_travel_assistant",
      "type": "string"
    },
    {
      "key": "REQUEST_ID",
      "value": "req_example_id",
      "type": "string"
    },
    {
      "key": "DELIVERY_ID",
      "value": "del_example_id",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Developer Platform",
      "item": [
        {
          "name": "Developer Overview & Onboarding",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{API_KEY}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{BASE_URL}}/developer/overview",
              "host": [
                "{{BASE_URL}}"
              ],
              "path": [
                "developer",
                "overview"
              ]
            }
          }
        },
        {
          "name": "Create Sandbox API Key",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-API-Key",
                "value": "{{API_KEY}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"name\": \"Sandbox Integration Key\", \"environment\": \"sandbox\"}"
            },
            "url": {
              "raw": "{{BASE_URL}}/developer/api-keys",
              "host": [
                "{{BASE_URL}}"
              ],
              "path": [
                "developer",
                "api-keys"
              ]
            }
          }
        },
